{{- $isWsl := eq .chezmoi.kernel.osrelease ".*microsoft.*" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}
{{- $isLinuxNative := and $isLinux (not $isWsl) -}}
# Managed by chezmoi - user additions go in ~/.ssh/config.local

Host *
{{- if $isLinuxNative }}
    IdentityAgent ~/.1password/agent.sock
{{- end }}
    AddKeysToAgent confirm

# User-specific SSH config
{{- if fileExists (joinPath .chezmoi.homeDir ".ssh/config.local") }}
{{ include (joinPath .chezmoi.homeDir ".ssh/config.local") }}
{{- end }}
