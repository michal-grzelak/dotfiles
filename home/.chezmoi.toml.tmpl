{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $name := promptStringOnce . "name" "Full name" -}}
{{- $gitSigningKey := promptStringOnce . "gitSigningKey" "Git signing key (leave empty for no signing)" "" -}}
{{- $isWsl := .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{- $isLinux := eq .chezmoi.os "linux" -}}

encryption = "age"

[data]
    email = {{ $email | quote }}
    name = {{ $name | quote }}
    isWsl = {{ $isWsl }}
    isLinux = {{ $isLinux }}
    isLinuxNative = {{ and $isLinux (not $isWsl) }}

    [data.git]
        signingKey = {{ $gitSigningKey | quote }}

[git]
    autoPush = false
    autoAdd = false
    autoCommit = false

[diff]
    pager = "delta"

[merge]
    command = "nvim"
    args = ["-d", "{{ .Destination }}", "{{ .Source }}", "{{ .Target }}"]

# Hooks
[hooks.apply.post]
command = "echo"
args = ["Dotfiles applied successfully!"]

[hooks.init.post]
command = "echo"
args = ["Chezmoi initialized. Run 'chezmoi apply' to apply dotfiles."]
