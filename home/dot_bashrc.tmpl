# Source loader files (explicit list - no wildcards)
[[ -r "$HOME/.config/bash/lib/loader.sh" ]]     && source "$HOME/.config/bash/lib/loader.sh"
[[ -r "$HOME/.config/bash/tools/loader.sh" ]]   && source "$HOME/.config/bash/tools/loader.sh"
[[ -r "$HOME/.config/bash/functions/loader.sh" ]] && source "$HOME/.config/bash/functions/loader.sh"

# Starship prompt
if command -v starship &> /dev/null; then
    eval "$(starship init bash)"
fi

# Local overrides
if [[ -f ~/.bashrc.local ]]; then
    source ~/.bashrc.local
fi
