# Source loader files
if test -f "$HOME/.config/fish/lib/loader.fish"
    source "$HOME/.config/fish/lib/loader.fish"
end
if test -f "$HOME/.config/fish/tools/loader.fish"
    source "$HOME/.config/fish/tools/loader.fish"
end
if test -f "$HOME/.config/fish/functions/loader.fish"
    source "$HOME/.config/fish/functions/loader.fish"
end

# XDG directories
set -gx XDG_CONFIG_HOME ~/.config
set -gx XDG_DATA_HOME ~/.local/share
set -gx XDG_CACHE_HOME ~/.cache

# Starship prompt
if type -q starship
    starship init fish | source
end




# Git aliases
alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline'
alias gd='git diff'
alias gb='git branch'

# Include local config if it exists
if test -f ~/.config/fish/config.local.fish
    source ~/.config/fish/config.local.fish
end
