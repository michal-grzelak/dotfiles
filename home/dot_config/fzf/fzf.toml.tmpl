--color=dark
--color=fg:-1,bg:-1,hl:#5fff87,fg+:-1,bg+:-1,hl+:#ffaf5f--color=info:#af87ff,prompt:#5fff87,pointer:#ff87d7,marker:#ff87d7,spinner:#ff87d7# Colors (custom theme)

# Preview settings
--preview-window=right:50%:wrap

--preview = 'bat --color=always --style=numbers --line-range=:500 {}'
--layout=reverse
--border=rounded
--height=80%

# Layout
# Key bindings
--bind = 'ctrl-y:execute-silent(echo {} | pbcopy)+abort'
--bind = 'ctrl-/:toggle-preview'
