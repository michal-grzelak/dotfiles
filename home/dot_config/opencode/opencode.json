{
  "$schema": "https://opencode.ai/config.json",
  "shell": "fish",
  "lsp": {},
  "formatter": {},
  "provider": {
    "lm-studio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "lm-studio",
      "options": {
        "baseURL": "http://localhost:1234/v1",
        "apiKey": "he9gjrvm9werp9349e08a3werpo0i34089jgreio"
