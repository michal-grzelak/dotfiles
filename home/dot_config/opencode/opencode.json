{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lm-studio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "lm-studio",
      "options": {
        "baseURL": "http://localhost:1234/v1",
        "apiKey": "he9gjrvm9werp9349e08a3werpo0i34089jgreio"
      },
      "models": {
        "qwen3.6": {
          "limit": {
            "context": 128000,
            "output": 8000,
            "input": 120000
          }
        }
      }
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "plan-agent",
        "planningAgents": ["plan"]
      }
    ]
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    }
  },
  "permission": {
    "context7*": "allow",
    "sequential-thinking*": "deny"
  },
  "agent": {
    "plan": {
      "permission": {
        "sequential-thinking*": "allow"
      }
    },
    "explore": {
      "permission": {
        "sequential-thinking*": "allow"
      }
    },
    "general": {
      "permission": {
        "sequential-thinking*": "allow"
      }
    },
    "build": {
      "model": "lm-studio/qwen3.6"
    }
  },
  "formatter": {}
}
