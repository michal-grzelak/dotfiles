// MANAGED BY CHEZMOI! EDIT ONLY WITH: chezmoi edit
{
  "$schema": "https://opencode.ai/config.json",
  "shell": "fish",
  "lsp": {},
  "formatter": {},
  "providers": {
    "lm-studio": {
      "name": "lm-studio",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:1234/v1",
        "apiKey": "he9gjrvm9werp9349e08a3werpo0i34089jgreio"
      },
      "models": {
        "qwen3.6": {
          "limit": {
            "context": 128000,
            "output": 8000,
            "input": 120000
          }
        }
      }
    }
  },
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@upstash/context7-opencode",
    {
      "package": "@plannotator/opencode@latest",
      "options": {
        "workflow": "plan-agent",
        "planningAgents": [
          "plan"
        ]
      }
    }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ],
        "disabled": false
      }
    }
  },
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "customize-opencode", "effect": "allow" },
    { "action": "skill", "resource": "context7-mcp", "effect": "allow" },
    // ! when superpowers adds a skill, add it to this list
    { "action": "skill", "resource": "brainstorming", "effect": "allow" },
    { "action": "skill", "resource": "dispatching-parallel-agents", "effect": "allow" },
    { "action": "skill", "resource": "executing-plans", "effect": "allow" },
    { "action": "skill", "resource": "finishing-a-development-branch", "effect": "allow" },
    { "action": "skill", "resource": "receiving-code-review", "effect": "allow" },
    { "action": "skill", "resource": "requesting-code-review", "effect": "allow" },
    { "action": "skill", "resource": "subagent-driven-development", "effect": "allow" },
    { "action": "skill", "resource": "systematic-debugging", "effect": "allow" },
    { "action": "skill", "resource": "test-driven-development", "effect": "allow" },
    { "action": "skill", "resource": "using-git-worktrees", "effect": "allow" },
    { "action": "skill", "resource": "using-superpowers", "effect": "allow" },
    { "action": "skill", "resource": "verification-before-completion", "effect": "allow" },
    { "action": "skill", "resource": "writing-plans", "effect": "allow" },
    { "action": "skill", "resource": "writing-skills", "effect": "allow" }
  ],
  "agents": {
    "plan": {
      "permissions": []
    },
    "explore": {
      "permissions": []
    },
    "general": {
      "permissions": []
    },
    "build": {}
  }
}
