#!/usr/bin/env bash
# MANAGED BY CHEZMOI! EDIT ONLY WITH: chezmoi edit

# Package installation script using brew bundle
# .Brewfile hash: {{ includeTemplate "dot_Brewfile.tmpl" . | sha256sum }}

set -e

# Check if Homebrew is installed
if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew not found."
    echo ""
    echo "Please install Homebrew first"
    echo ""
    echo "After installation, add Homebrew to your PATH and run 'chezmoi apply' again."
    exit 1
fi

# Run brew bundle
if [ -z "$HOMEBREW_BUNDLE_FILE" ]; then
    echo "=== Sourcing .bashrc (new installation) ==="
    source "$HOME/.bashrc"
fi

echo "=== Installing packages from Brewfile ==="
brew bundle
echo "=== Package installation complete ==="
